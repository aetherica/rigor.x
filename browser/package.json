{
  "name": "@aetherica/browser",
  "version": "0.1.0",
  "private": true,
  "description": "Aetherica standalone browser MCP server",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "aetherica-browser": "./cli.mjs"
  },
  "scripts": {
    "test": "node --no-warnings --experimental-strip-types --test core/*.test.ts geckodriver/*.test.ts providers/*.test.ts routing/*.test.ts sessions/*.test.ts",
    "start": "node --experimental-strip-types server.ts",
    "typecheck": "npx tsc -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "playwright-core": "^1.56.1"
  }
}
