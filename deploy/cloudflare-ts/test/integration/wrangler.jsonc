{
	// Integration harness for `wrangler dev` only (never deployed: Workers Builds uses ../../wrangler.jsonc).
	// It runs the real OwnerRuns Durable Object class on workerd's SQLite, called over RPC from a
	// tiny forwarding Worker, so storage behaviour is tested without adding any route to the real Worker.
	"name": "rigorx-mcp-integration",
	"main": "entry.ts",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"durable_objects": {
		"bindings": [
			{ "name": "OWNER_RUNS", "class_name": "OwnerRuns" },
			{ "name": "MIGRATION_PROBE", "class_name": "MigrationProbe" },
			{ "name": "WRITE_METER", "class_name": "WriteMeter" },
			{ "name": "TX_PROBE", "class_name": "TxProbe" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["OwnerRuns", "MigrationProbe", "WriteMeter", "TxProbe"] }],
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
	"vars": {
		"RIGORX_CALLS_PER_DAY": "6",
		"RIGORX_RUNS_PER_DAY": "100",
		"RIGORX_STORED_RUNS": "500",
		"RIGORX_BURST_PER_MINUTE": "1000",
		"RIGORX_FETCHES_PER_DAY": "200"
	}
}
