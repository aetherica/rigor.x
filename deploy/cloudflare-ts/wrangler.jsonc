{
	// RIGOR-X MCP server on Cloudflare Workers (TypeScript; one runtime dependency, Cloudflare's OAuth provider).
	// Same Worker name, Durable Object class and storage schema as the Python spike in ../cloudflare,
	// so existing runs remain readable. The v1 migration is already applied on Cloudflare.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rigorx-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-07",
	// global_fetch_strictly_public: required by the OAuth provider to fetch Client ID Metadata Documents.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": true,
	// Static assets (2026-11-26): the circular Aetherica icons (/icon-<size>.png, /favicon.ico) are
	// served by the asset layer without running the Worker (free, cached). Every other path runs the
	// Worker first, exactly as before, so OAuth navigations (/authorize, the Google callback) and
	// /mcp never depend on asset routing.
	"assets": {
		"directory": "./public",
		"run_worker_first": ["/*", "!/icon-*", "!/favicon.ico"]
	},
	"preview_urls": false,
	"durable_objects": {
		"bindings": [
			{
				"name": "OWNER_RUNS",
				"class_name": "OwnerRuns"
			}
		]
	},
	// Clients, grants and tokens of the OAuth provider (auth.ts). Tokens are stored only as hashes.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "2c84dcf183d041bbb7dd8f98a4f4b1ad"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"OwnerRuns"
			]
		}
	],
	// Provisional per-owner limits (WS32 P0.3); final numbers come with the move to Workers Paid.
	"vars": {
		"RIGORX_CALLS_PER_DAY": "2000",
		"RIGORX_RUNS_PER_DAY": "100",
		"RIGORX_STORED_RUNS": "500",
		"RIGORX_BURST_PER_MINUTE": "120"
	},
	"observability": {
		"enabled": true,
		"issues": {
			"enabled": true
		}
	}
}
