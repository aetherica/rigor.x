# Portable Node runtime: environment template. Copy to .env (never commit .env) or set these in
# your host's dashboard. Secrets go in the host's secret store, not in this file or in Git.

# Required. The public origin users and MCP clients reach (scheme://host[:port], no path).
# OAuth metadata, redirect and callback URLs are built on it; the Host header is never trusted.
PUBLIC_ORIGIN=https://your-service.example.com

# Required in production (NODE_ENV=production): the Google OAuth web client. Add
#   <PUBLIC_ORIGIN>/oauth/google/callback
# to the client's authorized redirect URIs in Google Cloud Console first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage: sqlite (files in DATA_DIR; needs a persistent disk) or postgres (persistent, for hosts
# without a disk, e.g. Supabase). With postgres, DATA_DIR only holds a disposable cache.
STORAGE=postgres
DATA_DIR=/data

# --- STORAGE=postgres (see README "PostgreSQL storage") ---
# Supabase: Dashboard -> Connect -> Session pooler (port 5432). Port 6543 (transaction pooler) is refused.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Secret: set it in the host's secret store, never here.
DATABASE_URL=
# Supabase's CA certificate as PEM text (Dashboard -> Database Settings -> SSL Configuration).
# TLS with certificate and hostname verification is mandatory.
DATABASE_CA_CERT=
# Secret: HMAC key for owner storage keys, at least 32 characters (openssl rand -base64 48).
# Keep it stable; to rotate, move the old value to OWNER_KEY_SECRET_PREVIOUS.
OWNER_KEY_SECRET=
# OWNER_KEY_SECRET_PREVIOUS=
# DATABASE_POOL_MAX=5
# OWNER_SNAPSHOT_MAX_BYTES=8388608
# STORAGE_MAX_ATTEMPTS=4
# Run the migration command once before the first start and after upgrades:
#   node --import ./deploy/node/register.mjs --experimental-strip-types deploy/node/migrate.ts

# Listening address. Most hosts set PORT themselves.
HOST=0.0.0.0
PORT=8787
NODE_ENV=production

# Release identity shown by /version (Render and Railway set their own commit variables).
# RIGORX_VERSION_TAG=

# Per-owner quotas (same names and defaults as the Cloudflare Worker, wrangler.jsonc).
RIGORX_CALLS_PER_DAY=2000
RIGORX_RUNS_PER_DAY=100
RIGORX_STORED_RUNS=500
RIGORX_BURST_PER_MINUTE=120
RIGORX_FETCHES_PER_DAY=200

# Optional: comma-separated SHA-256 hex prefixes (16-64 characters) of suspended owners.
# RIGORX_SUSPENDED_OWNERS=

# Optional tuning.
# SHUTDOWN_GRACE_MS=10000
# MAX_BODY_BYTES=2097152
